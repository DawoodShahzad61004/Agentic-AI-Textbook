{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"\"C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"Get-Content -LiteralPath 'db/connection.js' -Raw\"","aggregated_output":"const { MongoClient } = require('mongodb');\n\nconst MONGO_URI = 'mongodb://127.0.0.1:27017';\nconst DB_NAME = 'temp_work_db';\n\nlet client;\nlet db;\nlet connecting;\n\nasync function connect() {\n  if (db) {\n    return db;\n  }\n\n  if (!connecting) {\n    client = new MongoClient(MONGO_URI);\n    connecting = client\n      .connect()\n      .then((connectedClient) => {\n        db = connectedClient.db(DB_NAME);\n        return db;\n      })\n      .catch((error) => {\n        client = undefined;\n        db = undefined;\n        throw error;\n      })\n      .finally(() => {\n        connecting = undefined;\n      });\n  }\n\n  return connecting;\n}\n\nasync function getDb() {\n  return connect();\n}\n\nasync function getClient() {\n  await connect();\n  return client;\n}\n\nasync function ping() {\n  const database = await connect();\n  const result = await database.command({ ping: 1 });\n  return result.ok === 1;\n}\n\nasync function close() {\n  if (connecting) {\n    await connecting;\n  }\n\n  if (client) {\n    await client.close();\n  }\n\n  client = undefined;\n  db = undefined;\n  connecting = undefined;\n}\n\nmodule.exports = {\n  MONGO_URI,\n  DB_NAME,\n  connect,\n  getDb,\n  getClient,\n  ping,\n  close,\n};\r\n","exit_code":0,"status":"completed"}}
